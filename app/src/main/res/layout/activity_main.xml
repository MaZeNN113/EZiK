<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#0F0F14">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_marginBottom="24dp"
        android:gravity="center" />

    <Button
        android:id="@+id/makeDefaultButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_make_default"
        android:backgroundTint="#6C5CE7"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/openAssistantSettingsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_open_assistant_settings"
        android:backgroundTint="#3A3A49"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/shizukuStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/requestShizukuButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_request_shizuku"
        android:backgroundTint="#3A3A49"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/openAccessibilitySettingsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_open_accessibility_settings"
        android:backgroundTint="#3A3A49"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/openAppSettingsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_open_app_settings"
        android:backgroundTint="#3A3A49"
        android:textColor="#FFFFFF" />

</LinearLayout>
