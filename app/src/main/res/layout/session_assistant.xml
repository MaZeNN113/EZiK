<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="18dp" android:background="@drawable/panel">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="EZiK" android:textColor="#F6F7FB" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/sessionStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Listening" android:textColor="#A9A0FF" android:textSize="12sp"/>
    </LinearLayout>
    <EditText android:id="@+id/commandInput" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:background="@android:color/transparent" android:hint="@string/hint_command"
        android:textColorHint="#747B8B" android:textColor="#F6F7FB" android:textSize="18sp"
        android:inputType="textCapSentences|textMultiLine" android:minLines="2" android:imeOptions="actionSend"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <Button android:id="@+id/voiceButton" android:layout_width="wrap_content" android:layout_height="44dp"
            android:background="@drawable/pill" android:text="@string/btn_voice_start" android:textColor="#E8E9EF"/>
        <Space android:layout_width="8dp" android:layout_height="1dp"/>
        <Button android:id="@+id/sendButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@drawable/primary_button" android:text="@string/btn_send" android:textColor="#FFFFFF"/>
    </LinearLayout>
</LinearLayout>
